        <mxCell id="jlRCw5SUV_52rrAENi7e-114" value="&lt;b&gt;Left part&lt;/b&gt;: initial setup and what we are planning marked with arrows&lt;br&gt;&lt;b&gt;Right part&lt;/b&gt;: output (state of cells after movement)&lt;br&gt;letter to distinguish cells&lt;br&gt;&lt;b&gt;Rounded cells&lt;/b&gt; also need a check of what&#39;s inside (ex: black move: cell b shall contain what cell a contained)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="70" y="-110" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jlRCw5SUV_52rrAENi7e-115" value="&lt;b&gt;first thing to check is that king is not in check&lt;/b&gt;&amp;nbsp;(if it is, king must move)!&lt;br&gt;&lt;br&gt;&lt;b&gt;possible move&lt;/b&gt;: the type of the piece has to allow the move and there must be no blocking elements in its way, except for knight, if king cell should not be in check&lt;br&gt;&lt;b&gt;&lt;br&gt;Move and capture&lt;/b&gt;: move has to be possible&lt;br&gt;&lt;b&gt;Castle&lt;/b&gt;: cells a, b, c, d must be very specific (4 possibilities, can be hardcoded), and there shall be no blocking elements, and cells between should not be in check&lt;br&gt;&lt;b&gt;En passant&lt;/b&gt;: both pawns, b has to be on rank 2, very specific setup, permitted only on the turn immediately after the two-square advance" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="75" y="800" width="370" height="200" as="geometry" />
        </mxCell>
